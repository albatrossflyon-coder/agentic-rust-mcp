# Agentic Rust MCP — Real MCP JSON-RPC 2.0 Server
# Copy this file to .env and fill in your actual API credentials

# ============================================================================
# Deployment APIs (for agency_pulse tool)
# ============================================================================
# Render API Key — check live Render service status
# Get from: https://dashboard.render.com/account/api-tokens
RENDER_API_KEY=

# Vercel API Token — check live Vercel deployments
# Get from: https://vercel.com/account/tokens
VERCEL_TOKEN=

# ============================================================================
# Content Scheduling (for content_check tool)
# ============================================================================
# Buffer API Key — check scheduled social media posts
# Get from: https://buffer.com/settings/apps/installed
BUFFER_API_KEY=

# ============================================================================
# Data Storage (for data_vault tool)
# ============================================================================
# Firebase Project ID
# Get from: https://console.firebase.google.com
FIREBASE_PROJECT_ID=

# Firebase API Key (REST API key, not service account)
# Get from: https://console.firebase.google.com/project/[PROJECT]/settings/general
FIREBASE_API_KEY=

# ============================================================================
# Optional: Logging
# ============================================================================
# Log level: trace, debug, info, warn, error (default: info)
RUST_LOG=info
