# Agentic Rust MCP - Environment Configuration
# Copy this file to .env and fill in your actual credentials

# ============================================================================
# OAuth 2.1 Configuration
# ============================================================================
# Your OAuth 2.1 token for API authentication
# Format: Bearer token from your provider
OAUTH_TOKEN=your-oauth-2.1-token-here

# ============================================================================
# Deployment APIs
# ============================================================================
# Render API Key (for deployment monitoring)
# Get from: https://dashboard.render.com/account/api-tokens
RENDER_API_KEY=rnd_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vercel API Token (for deployment monitoring)
# Get from: https://vercel.com/account/tokens
VERCEL_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# Content Scheduling (Buffer)
# ============================================================================
# Buffer OAuth Token
# Get from: https://buffer.com/settings/apps/installed
BUFFER_TOKEN=your-buffer-token-here

# ============================================================================
# Data Storage (Firestore)
# ============================================================================
# Google Cloud Project ID
GOOGLE_CLOUD_PROJECT=your-project-id

# Firestore Database ID (usually "default")
FIRESTORE_DATABASE=default

# Service Account Key Path (JSON file)
# Get from: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# ============================================================================
# Logging
# ============================================================================
# Log level: trace, debug, info, warn, error
RUST_LOG=info

# Enable JSON logging for production (true/false)
JSON_LOGGING=true

# ============================================================================
# Server Configuration
# ============================================================================
# Port for HTTP server (future use)
# SERVER_PORT=3000

# Environment: development, staging, production
ENVIRONMENT=production
